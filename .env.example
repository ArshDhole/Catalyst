# Catalyst Environment Configuration
# Pick ANY provider — set its key and optionally AI_PROVIDER + model.
# No key? Catalyst still runs offline rule-based migrations (Python 2→3, ES5→ES2020).

# --- Provider selection: auto|anthropic|openai|gemini|openrouter|zen|custom ---
AI_PROVIDER=auto
# Generic model override (applies to whichever provider resolves):
# MODEL=

# --- Anthropic Claude (native Messages API) ---
ANTHROPIC_API_KEY=sk-ant-your-key-here
# ANTHROPIC_MODEL=claude-opus-4-20250805

# --- OpenAI ChatGPT (chat completions) ---
# OPENAI_API_KEY=sk-your-openai-key
# OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions

# --- Google Gemini ---
# GEMINI_API_KEY=your-gemini-key
# GEMINI_MODEL=gemini-2.0-flash

# --- OpenRouter (many models, one key) ---
# OPENROUTER_API_KEY=sk-or-your-key
# OPENROUTER_MODEL=anthropic/claude-opus-4-6
# OPENROUTER_SITE_URL=http://localhost:3000
# OPENROUTER_APP_NAME=Catalyst

# --- OpenCode Zen (AI gateway; chat/completions models only) ---
# ZEN_API_KEY=your-zen-key
# ZEN_MODEL=big-pickle
# (chat/completions models: big-pickle, kimi-k3, glm-5, qwen3-coder, ...)

# --- Custom OpenAI-compatible server (Ollama, LM Studio, vLLM, Together, Groq, ...) ---
# CUSTOM_BASE_URL=http://localhost:11434/v1/chat/completions
# CUSTOM_API_KEY=ollama
# CUSTOM_MODEL=default

# --- RAG retrieval (chunk + retrieve repo & migration knowledge) ---
# RAG_ENABLED=1 (0 to disable and use the full structure dump)
# RAG_EMBEDDING=auto (auto|tfidf|provider — auto uses provider vectors when a
#   key exists for openai/openrouter/gemini, else local hashed-tfidf, $0)
# RAG_TOP_K=12
# RAG_CONTEXT_CHARS=24000

NODE_ENV=development
PORT=3000
APP_NAME=Catalyst
APP_TAGLINE=Transform legacy code into modern systems with AI precision
# DATABASE_URL=postgresql://user:password@localhost:5432/catalyst_db
